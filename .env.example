# Copy to .env.local and fill in. Never commit .env.local.
# Required values throw loudly on first use rather than failing at request time.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/neep

# Keys every HMAC: form tokens, IP hashing, session token hashing. Never sent to
# the client. Must be at least 32 characters of high-entropy material.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# --- Public site ------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hours within which the company commits to answering a new inquiry. This is a
# single source of truth: it is published on the site, stored per inquiry as
# response_due_at, and drives the overdue flag in admin. Changing it changes
# both sides at once.
RESPONSE_SLA_HOURS=24

# --- Contact routes ---------------------------------------------------------
# Leave blank when not yet real. A contact route that is not configured renders
# as absent, never as a placeholder. A fake phone number on a lead-generation
# site destroys trust on the one call that mattered.

NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=

# --- Email delivery (optional) ----------------------------------------------
# Both must be set for delivery. Absent means notifications are recorded with
# status no_provider and the admin says so plainly, never a green tick.

RESEND_API_KEY=
EMAIL_FROM=
INQUIRY_NOTIFICATION_EMAIL=

# --- Browser checks (optional) ----------------------------------------------
# scripts/ resolve Chromium under PLAYWRIGHT_BROWSERS_PATH automatically.
# Set CHROMIUM_EXECUTABLE only to pin a specific binary.

# VERIFY_BASE_URL=http://localhost:3000
# CHROMIUM_EXECUTABLE=
# VERIFY_ADMIN_EMAIL=
# VERIFY_ADMIN_PASSWORD=
